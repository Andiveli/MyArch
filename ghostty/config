# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                   FONT                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

font-family = "JetBrainsMono Nerd Font"
font-size = 14
#font-feature = +calt


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  WINDOW                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

background-opacity = 0.4
background-blur-radius = 20
window-decoration = false
window-padding-color = extend
window-padding-balance = true
window-step-resize = false
window-padding-balance = true
window-height = 100
window-width = 100

gtk-tabs-location = hidden
mouse-hide-while-typing = true

# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  SHADER                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

custom-shader = shaders/cursor_smear_samael.glsl

# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                            INPUT / KEYBINDINGS                               │
# └──────────────────────────────────────────────────────────────────────────────┘

# Split Management
#keybind = alt+v=new_split:right
#keybind = alt+d=new_split:down

# Split Navigation
#keybind = alt+k=goto_split:up
#keybind = alt+j=goto_split:down
#keybind = alt+h=goto_split:left
#keybind = alt+l=goto_split:right

# Split Resize
#keybind = ctrl+shift+j=resize_split:up,10
#keybind = ctrl+shift+k=resize_split:down,10
#keybind = ctrl+shift+h=resize_split:left,10
#keybind = ctrl+shift+l=resize_split:right,10

# Miscellaneous
keybind = cmd+k=clear_screen
keybind = shift+enter=text:\x1b\r

# Navigation
#keybind = alt+k=goto_tab:up
#keybind = alt+j=goto_tab:down
#keybind = alt+h=goto_tab:left
#keybind = alt+l=goto_tab:right


# Open file with nvim (write 'nvim' first, then use this keybinding)
keybind = alt+s=write_screen_file:paste


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                           SAMAEL THEME                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

# --- Base Colors ---
background = 06080f
foreground = f3f6f9
cursor-color = e0c15a
selection-background = 263356
selection-foreground = f3f6f9

# --- Normal Colors ---
palette = 0=#06080f
palette = 1=#cb7c94
palette = 2=#b7cc85
palette = 3=#ffe066
palette = 4=#7fb4ca
palette = 5=#ff8dd7
palette = 6=#7aa89f
palette = 7=#f3f6f9

# --- Bright Colors ---
palette = 8=#8a8fa3
palette = 9=#de8fa8
palette = 10=#d1e8a9
palette = 11=#fff7b1
palette = 12=#a3d4d5
palette = 13=#ffaeea
palette = 14=#7fb4ca
palette = 15=#f3f6f9

confirm-close-surface = false
linux-cgroup = never
gtk-tabs-location = hidden

